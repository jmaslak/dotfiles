#!/bin/zsh
# Alias Definitions

# SSH w/ color
# Colorizes stdout and stderr as two independent streams (each through its
# own router-colorizer) via a double fd-swap. zsh can't attach a {name} fd
# allocation directly to a (...) subshell like bash can, so the allocation
# is done with a plain `exec` first and the swap redirects reference it.
_ssh_colorized() {
    (
      exec {fd2}>&2
      (
        (
          exec {fd}>&2
          command ssh "$@" 2>&1 1>&$fd
        ) | router-colorizer
      ) 2>&1 1>&$fd2
    ) | router-colorizer
}

ssh() {
    if echo | router-colorizer 2>/dev/null >/dev/null ; then
        SSHR_WORKS=yes
    else
        SSHR_WORKS=no
    fi

    ROUTER=no
    VT102=no
    ROUTER_RE=" ([ac]sw|[ace]s|dcr|ert|o[hst]|pe|rr|wdm)[0-9][0-9]\.[a-z][a-z][a-z][0-9][0-9][0-9] | [al]r[0-9]| fw[0-9]| sw[0-9]| cs[0-9]"
    VT102_RE=" o[hst][0-9][0-9]\.[a-z][a-z][a-z][0-9][0-9][0-9] "

    [[ " $* " =~ $ROUTER_RE ]] && ROUTER=yes
    [[ " $* " =~ $VT102_RE || "$*" = "sw02" ]] && VT102=yes

    if [ "$SSHR_WORKS $ROUTER" = "yes yes" ] ; then
        # SSHR works good
        if [ "$VT102" = "yes" ] ; then
            TERM=vt102 _ssh_colorized "$@"
        else
            _ssh_colorized "$@"
        fi
    else
        # No SSHR
        if [ "$VT102" = "yes" ] ; then
            TERM=vt102 command ssh "$@"
        else
            command ssh "$@"
        fi
    fi
}

# Simulate dice
alias d4="raku -e 'say (1..4).roll'"
alias d6="raku -e 'say (1..6).roll'"
alias d8="raku -e 'say (1..8).roll'"
alias d10="raku -e 'say (1..10).roll'"
alias d12="raku -e 'say (1..12).roll'"
alias d20="raku -e 'say (1..20).roll'"
alias d00="raku -e 'say (1..100).roll'"

alias nb="grep '\S'"          # no blank lines
alias nz="grep -E '[^0 ]'"    # no zeros
