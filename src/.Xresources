!! XTerm*faceName: Consolas Sans Mono
XTerm*faceName: Consolas
XTerm*faceSize: 11
XTerm*ToolBar: false
XTerm*ScrollBar: false
XTerm*selectToClipboard: true

#define S_base03        #002b36
#define S_base02        #073642
#define S_base01        #586e75
#define S_base00        #657b83
#define S_base0         #839496
#define S_base1         #93a1a1
#define S_base2         #eee8d5
#define S_base3         #fdf6e3

*background:            #000000
*foreground:            #aaaaaa
!! *fadeColor:             S_base3
!! *cursorColor:           S_base01
!! *pointerColorBackground:S_base1
!! *pointerColorForeground:S_base01

#define S_yellow        #b58900
#define S_orange        #cb4b16
#define S_red           #dc322f
#define S_magenta       #d33682
#define S_violet        #6c71c4
#define S_blue          #268bd2
#define S_cyan          #2aa198
#define S_green         #859900

!! black dark/light
!! *color0:                S_base02
!! *color8:                S_base03

!! red dark/light
!! *color1:                S_red
!! *color9:                S_orange

!! green dark/light
!! *color2:                S_green
!! *color10:               S_base01

!! yellow dark/light
!! *color3:                S_yellow
!! *color11:               S_base00

!! blue dark/light
!! *color4:                S_blue
!! *color12:               S_base0

!! magenta dark/light
!! *color5:                S_magenta
!! *color13:               S_violet

!! cyan dark/light
!! *color6:                S_cyan
!! *color14:               S_base1

!! white dark/light
!! *color7:                S_base2
!! *color15:               S_base3

! x3270 sets grey backgrounds on its menus but no foreground, so the
! global *foreground above would make menu text unreadable.
x3270*menuBarContainer*foreground: black
x3270*fileMenu*foreground:     black
x3270*exitMenu*foreground:     black
x3270*optionsMenu*foreground:  black
x3270*hostMenu*foreground:     black
x3270*macrosMenu*foreground:   black
x3270*togglesMenu*foreground:  black
x3270*fontsMenu*foreground:    black
x3270*modelsMenu*foreground:   black
x3270*colorsMenu*foreground:   black
x3270*codepageMenu*foreground: black
x3270*printerMenu*foreground:  black
x3270.colorScheme.black: black dodgerBlue red magenta lime cyan yellow white darkSlateGrey blue3 orange purple paleGreen2 paleTurquoise3 lightSlateGrey whiteSmoke white black dimGrey 4 2 1 15
x3270.colorScheme: black
Xft.dpi: 151
